{
    "build": { "dockerfile": "Dockerfile" },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.black-formatter",
                "ms-vscode-remote.remote-containers",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "forwardPorts": [8081],
    "postStartCommand": [
        "/root/miniforge3/bin/conda", "run", "--live-stream", "-n", "sage", "/bin/bash", "-c",
        "{ nohup python3 -m http.server -d /workspaces/dfl/docs/build/html/ 8081 > /dev/null & disown %1; }"
    ]
}